{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Feedback": {
    "AllowedOrigins": [],
    "TrustedProxies": [],
    "DataDirectory": "Data",
    "MaxRequestBytes": 16384,
    "MaxDailyBytes": 5242880,
    "MaxSubjectLength": 100,
    "MaxBodyLength": 3000,
    "RateLimit": { "PerMinute": 1, "PerHour": 5, "PerDay": 20 }
  }
}
